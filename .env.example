# Copy to .env; no secrets are required to run the demo.
# The hash salt feeds deterministic hashing of mapped fields; set a long
# random value in production. Connector credentials are read from env vars
# named in each connector's credential_env (e.g. DINT_ORDERS_API_KEY).
DINT_HASH_SALT=<redacted>
DINT_HOST=0.0.0.0
DINT_PORT=8000
# DINT_ORDERS_API_KEY=
# DINT_CUSTOMERS_API_TOKEN=
# DINT_PRODUCTS_DB_PASSWORD=
